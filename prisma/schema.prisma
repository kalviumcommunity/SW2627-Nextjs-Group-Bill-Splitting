generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  age           Int
  passwordHash  String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdExpenses       Expense[]         @relation("ExpenseCreator")
  expenseMemberships    ExpenseMember[]
  otpVerifications      OtpVerification[]
  reviewedContributions Contribution[]    @relation("ContributionReviewer")
}

model OtpVerification {
  id        String    @id @default(cuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Expense {
  id          String        @id @default(cuid())
  creatorId   String
  totalAmount Decimal       @db.Decimal(12, 2)
  deadline    DateTime
  status      ExpenseStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  creator   User            @relation("ExpenseCreator", fields: [creatorId], references: [id])
  members   ExpenseMember[]
  shortfall Shortfall?

  @@index([creatorId])
  @@index([status])
  @@index([deadline])
}

model ExpenseMember {
  id             String   @id @default(cuid())
  expenseId      String
  userId         String
  assignedAmount Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  expense       Expense        @relation(fields: [expenseId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  contributions Contribution[]

  @@unique([expenseId, userId])
  @@index([userId])
}

model Contribution {
  id              String             @id @default(cuid())
  expenseMemberId String
  amount          Decimal            @db.Decimal(12, 2)
  status          ContributionStatus @default(PENDING)
  idempotencyKey  String             @unique
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  expenseMember ExpenseMember @relation(fields: [expenseMemberId], references: [id])
  reviewedBy    User?         @relation("ContributionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  paymentProof  PaymentProof?

  @@index([expenseMemberId])
  @@index([status])
  @@index([reviewedById])
}

model PaymentProof {
  id             String   @id @default(cuid())
  contributionId String   @unique
  fileUrl        String
  fileName       String
  uploadedAt     DateTime @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
}

model Shortfall {
  id        String          @id @default(cuid())
  expenseId String          @unique
  amount    Decimal         @db.Decimal(12, 2)
  status    ShortfallStatus @default(OPEN)
  createdAt DateTime        @default(now())
  settledAt DateTime?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

enum ExpenseStatus {
  ACTIVE
  CLOSED
}

enum ContributionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ShortfallStatus {
  OPEN
  SETTLED
}
